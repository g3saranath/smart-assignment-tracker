# --- Gemini (required) -------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# TIP: if you get a 429 with "limit: 0", create the key via
# "Create API key in a NEW project" — older/billing-linked projects often have
# no free-tier quota.
GEMINI_API_KEY=your_key_here
# Optional: switch models without touching code. Try gemini-2.5-flash or
# gemini-1.5-flash if 2.0-flash has no quota on your project.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=3

# --- Server ------------------------------------------------------------------
PORT=3001

# --- MinerU document parsing (OCR for image/scanned PDFs) ---------------------
# Reads image + text PDFs correctly and extracts figures for the agent.
# Setup:  pip install -U "mineru[all]"  &&  mineru-api --host 127.0.0.1 --port 8000
# When MINERU_API_URL is unset, PDFs fall back to text-only extraction (no OCR/
# figures) and image uploads are rejected.
MINERU_API_URL=http://127.0.0.1:8000
# pipeline (CPU-friendly, hallucination-free) | hybrid-engine | vlm-engine
MINERU_BACKEND=pipeline
# Optional OCR language hint (e.g. ch, korean, japan). Leave blank to use the
# service default, which handles English/Latin text.
MINERU_LANG=
# Max time to wait for a parse (ms). CPU parsing of large scans is slow.
MINERU_TIMEOUT_MS=300000
# Max figures attached to a single Gemini call (per extract/solve).
GEMINI_MAX_IMAGES=6

# --- Email notifications (optional; needed for reminder emails) --------------
# For Gmail: create an "App Password" (Google Account > Security > App passwords)
# and use it as SMTP_PASS with SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
