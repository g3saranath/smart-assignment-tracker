# --- Gemini (required) -------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# TIP: if you get a 429 with "limit: 0", create the key via
# "Create API key in a NEW project" — older/billing-linked projects often have
# no free-tier quota.
GEMINI_API_KEY=your_key_here
# Optional: switch models without touching code. Try gemini-2.5-flash or
# gemini-1.5-flash if 2.0-flash has no quota on your project.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=3

# --- Server ------------------------------------------------------------------
PORT=3001

# --- Email notifications (optional; needed for reminder emails) --------------
# For Gmail: create an "App Password" (Google Account > Security > App passwords)
# and use it as SMTP_PASS with SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
